REDUTA_ENV=dev
REDUTA_HTTP_ADDR=:8080
REDUTA_DATABASE_URL=postgres://reduta:reduta@localhost:5432/reduta?sslmode=disable
REDUTA_REDIS_ADDR=localhost:6379
REDUTA_LOG_LEVEL=info
REDUTA_SHUTDOWN_TIMEOUT=15s
REDUTA_SESSION_TTL=168h
REDUTA_SUBMIT_RATE_PER_MIN=10
# Optional bootstrap owner created on first start:
REDUTA_BOOTSTRAP_ADMIN_EMAIL=
REDUTA_BOOTSTRAP_ADMIN_PASSWORD=
